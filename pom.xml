<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 cc-hongz-ztools：国际化消息解析 -->
    <parent>
        <groupId>cc.hongz</groupId>
        <artifactId>cc-hongz-ztools</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 国际化消息解析：业务状态码 → 本地化消息（Spring MessageSource 封装） -->
    <artifactId>cc-hongz-ztools-i18n</artifactId>
    <packaging>jar</packaging>
    <name>cc-hongz-ztools-i18n</name>
    <description>Hongz ZTools i18n message resolver (business status code to localized message)</description>

    <dependencies>
        <!-- ZTools 状态码：消息解析的输入（业务状态码 + 默认消息） -->
        <dependency>
            <groupId>cc.hongz</groupId>
            <artifactId>cc-hongz-ztools-status</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring Context：MessageSource、LocaleContextHolder -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JUnit 5：单元测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Test：测试 MessageSource -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
